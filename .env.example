# URL сервера с контентом и релизами (без завершающего /)
# Используется при сборке (content:pull, electron-builder) и в runtime приложения
KNOWHUB_SERVER_URL=http://localhost:3000

# Продакшен (пример):
# KNOWHUB_SERVER_URL=https://shikarno.space/nvi/kh

# Необязательно: URL каталога релизов для electron-updater
# По умолчанию: {KNOWHUB_SERVER_URL}/releases/
# KNOWHUB_RELEASES_URL=https://your-server.example.com/releases
