# URL сервера с контентом и релизами (без завершающего /)
# Используется при сборке (content:pull, electron-builder) и в runtime приложения.
# Для production-сборки обязателен https://
KNOWHUB_SERVER_URL=https://apps.shikarno.space/nvi/knowhub

# Локальная разработка сервера:
# KNOWHUB_SERVER_URL=http://localhost:3000

# Необязательно: URL каталога релизов для electron-updater
# По умолчанию: {KNOWHUB_SERVER_URL}/releases/
# KNOWHUB_RELEASES_URL=https://apps.shikarno.space/nvi/knowhub/releases

# Code signing: production scripts set CSC_IDENTITY_AUTO_DISCOVERY=false (unsigned).
# To ship signed builds, remove that flag and provide platform certificates / notarization.
