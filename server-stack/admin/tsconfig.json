{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@knowhub-shared/*": ["../../src/shared/*"]
    }
  },
  "include": ["src", "../../src/shared/code-copy-icons.ts", "../../src/shared/code-hint.ts", "../../src/shared/code-hint-sanitize.ts", "../../src/shared/article-code-hints.ts"]
}
