# ── Обязательные ──────────────────────────────────────────────────────────────
# Пароль единственного пользователя админ-панели
ADMIN_PASSWORD=change-me-to-a-strong-password

# Логин (по умолчанию admin)
# ADMIN_USERNAME=admin

# ── Опциональные ──────────────────────────────────────────────────────────────
# Статический Bearer для скриптов (curl). Не встраивается в SPA.
# ADMIN_API_KEY=

# Подпуть на домене (без завершающего /). Для shikarno.space/nvi/kh/:
# BASE_PATH=/nvi/kh
# BASE_PATH=

# Порт, на котором nginx принимает входящие запросы
# На VPS за основным nginx часто 8080: HTTP_PORT=8080
HTTP_PORT=80

# Node.js порт внутри контейнера (не нужно менять без причины)
# PORT=3000
