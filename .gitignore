# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
server-stack/server/node_modules/
server-stack/admin/node_modules/

# ─── Build outputs ────────────────────────────────────────────────────────────
dist/
out/
server-stack/server/dist/
server-stack/admin/dist/

# ─── TypeScript build cache ───────────────────────────────────────────────────
*.tsbuildinfo

# ─── Downloaded binaries (generated by scripts / runtime download) ───────────
# WinBox64.exe (Windows), WinBox.app (macOS), WinBox (Linux) — see npm run winbox:download
resources/winbox/*
!resources/winbox/.gitkeep

# ─── Bundled content seed (manifest only; HTML pulled via npm run content:pull) ─
resources/content/*.html

# ─── Environment variables (contain secrets) ──────────────────────────────────
.env
server-stack/.env

# ─── Server runtime data (Docker volume mount) ────────────────────────────────
server-stack/data/

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Temp / debug files ───────────────────────────────────────────────────────
nul
test-minimal-main.js
