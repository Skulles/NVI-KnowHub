{
  "name": "nvi-knowhub",
  "version": "1.0.9",
  "description": "База знаний NVI",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "content:pull": "node --env-file=.env scripts/content-pull.js",
    "winbox:download": "node scripts/download-winbox.js",
    "icons:win": "node scripts/make-win-icon.js",
    "build": "npm run icons:win && npm run content:pull && npm run winbox:download && cross-env ELECTRON_RUN_AS_NODE= CSC_IDENTITY_AUTO_DISCOVERY=false electron-vite build && node --env-file=.env node_modules/electron-builder/out/cli/cli.js",
    "build:unpack": "npm run icons:win && npm run winbox:download && cross-env ELECTRON_RUN_AS_NODE= CSC_IDENTITY_AUTO_DISCOVERY=false electron-vite build && node --env-file=.env node_modules/electron-builder/out/cli/cli.js --dir",
    "preview": "cross-env ELECTRON_RUN_AS_NODE= electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty && tsc -p tsconfig.web.json --noEmit --pretty",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "keywords": [],
  "author": "NVI",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^9.39.5",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.38",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.3.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.2.8",
    "@fontsource-variable/outfit": "^5.2.8",
    "adm-zip": "^0.5.17",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
